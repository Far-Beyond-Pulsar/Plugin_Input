{
  "id": "1e57a000-0000-4000-8000-000000000002",
  "identifier": "Move",
  "description": "A 2D action (X right, Y forward). Keys are turned into directions by modifiers on the mapping entries; a stick comes through as is. The dead zone here removes stick drift for every binding.",
  "value_type": "axis2d",
  "consume_input": true,
  "trigger_when_paused": false,
  "actuation_threshold": 0.5,
  "triggers": [
    {
      "type": "down"
    }
  ],
  "modifiers": [
    {
      "type": "dead_zone",
      "lower": 0.15,
      "upper": 1.0,
      "radial": true
    }
  ]
}
