{
  "id": "1e57a000-0000-4000-8000-000000000101",
  "description": "On-foot gameplay: WASD or the left stick to move, mouse or right stick to look. Priority 0, the base layer every other mapping sits above. Each key entry carries the modifiers that point it the right way (W is X swizzled into Y; S is that negated).",
  "priority": 0,
  "categories": [
    {
      "id": 1,
      "name": "Movement",
      "entries": [
        {
          "id": 1,
          "key": "Keyboard.KeyW",
          "action": {
            "id": "1e57a000-0000-4000-8000-000000000002",
            "hint": "examples/actions/move.inputaction"
          },
          "enabled": true,
          "triggers": [],
          "modifiers": [
            {
              "type": "swizzle",
              "order": "yxz"
            }
          ],
          "note": "Forward: the key reports on X, the swizzle moves it to Y."
        },
        {
          "id": 2,
          "key": "Keyboard.KeyS",
          "action": {
            "id": "1e57a000-0000-4000-8000-000000000002",
